{
  "name": "nosleep-cli",
  "version": "0.0.1",
  "description": "Keep your Mac awake with the lid closed, with an auto-off guardrail",
  "scripts": {
    "changeset": "changeset",
    "release": "changeset publish",
    "version-packages": "changeset version && bun install --lockfile-only"
  },
  "packageManager": "bun@1.3.14",
  "bin": {
    "nosleep": "nosleep"
  },
  "files": [
    "nosleep",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/omsimos/nosleep.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "macos",
    "cli",
    "caffeinate",
    "sleep"
  ],
  "contributors": [
    "joshxfi",
    "blankeos",
    "princejoogie",
    "hyamero"
  ],
  "license": "MIT",
  "os": [
    "darwin"
  ],
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1"
  }
}
