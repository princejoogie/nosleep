#!/usr/bin/env swift

import CoreGraphics
import Darwin
import Foundation

private typealias GetBrightness = @convention(c) (
    CGDirectDisplayID,
    UnsafeMutablePointer<Float>
) -> Int32
private typealias SetBrightness = @convention(c) (CGDirectDisplayID, Float) -> Int32

private let frameworkPath =
    "/System/Library/PrivateFrameworks/DisplayServices.framework/DisplayServices"
private let program = URL(fileURLWithPath: CommandLine.arguments[0]).lastPathComponent
private var arguments = Array(CommandLine.arguments.dropFirst())

private func fail(_ message: String) -> Never {
    fputs("\(program): \(message)\n", stderr)
    exit(1)
}

private func usage() {
    print("""
    Usage: \(program) [get]
           \(program) snapshot
           \(program) set <level>
           \(program) <level>

    Options:
      --display <id>  Use a previously discovered built-in display ID.

    Read or set the built-in display brightness. Level must be from 0.0 to 1.0.
    """)
}

private func builtInDisplayID() -> CGDirectDisplayID {
    var count: UInt32 = 0
    guard CGGetOnlineDisplayList(0, nil, &count) == .success else {
        fail("unable to enumerate displays")
    }

    var displays = [CGDirectDisplayID](repeating: 0, count: Int(count))
    guard CGGetOnlineDisplayList(count, &displays, &count) == .success else {
        fail("unable to enumerate displays")
    }

    guard let display = displays.prefix(Int(count)).first(where: {
        CGDisplayIsBuiltin($0) != 0
    }) else {
        fail("no online built-in display found")
    }

    return display
}

if arguments == ["-h"] || arguments == ["--help"] || arguments == ["help"] {
    usage()
    exit(0)
}

private var requestedDisplay: CGDirectDisplayID?
if let optionIndex = arguments.firstIndex(of: "--display") {
    let valueIndex = arguments.index(after: optionIndex)
    guard valueIndex < arguments.endIndex,
          let display = CGDirectDisplayID(arguments[valueIndex]) else {
        fail("--display requires a numeric display ID")
    }
    requestedDisplay = display
    arguments.removeSubrange(optionIndex ... valueIndex)
}

guard !arguments.contains("--display") else {
    fail("--display may only be specified once")
}

guard let framework = dlopen(frameworkPath, RTLD_LAZY) else {
    let detail = dlerror().map { String(cString: $0) } ?? "unknown error"
    fail("unable to load DisplayServices: \(detail)")
}
defer { dlclose(framework) }

guard
    let getSymbol = dlsym(framework, "DisplayServicesGetBrightness"),
    let setSymbol = dlsym(framework, "DisplayServicesSetBrightness")
else {
    fail("brightness controls are unavailable on this version of macOS")
}

private let getBrightness = unsafeBitCast(getSymbol, to: GetBrightness.self)
private let setBrightness = unsafeBitCast(setSymbol, to: SetBrightness.self)
let display = requestedDisplay ?? builtInDisplayID()

func applyBrightness(_ value: String) {
    guard let level = Float(value), level.isFinite, (0 ... 1).contains(level) else {
        fail("invalid level '\(value)' (expected 0.0 to 1.0)")
    }

    let result = setBrightness(display, level)
    guard result == 0 else {
        fail("unable to set brightness (error \(result))")
    }
}

if arguments.isEmpty || arguments == ["get"] || arguments == ["snapshot"] {
    var level: Float = 0
    let result = getBrightness(display, &level)
    guard result == 0 else {
        fail("unable to read brightness (error \(result))")
    }
    if arguments == ["snapshot"] {
        print("\(display) \(String(format: "%.6f", level))")
    } else {
        print(String(format: "%.6f", level))
    }
} else if arguments.count == 2 && arguments[0] == "set" {
    applyBrightness(arguments[1])
} else if arguments.count == 1 {
    applyBrightness(arguments[0])
} else {
    usage()
    exit(1)
}
