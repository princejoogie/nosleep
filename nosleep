#!/usr/bin/env bash
#
# nosleep — keep this Mac awake, even with the lid closed (clamshell mode).
#
#   nosleep on [DURATION] [--battery=N|--no-battery]  Disable sleep, auto-off later
#   nosleep off             Restore normal sleep behavior now
#   nosleep status          Show current state and time remaining
#   nosleep --help          Show usage
#
# DURATION defaults to 3h. Accepts 3h, 90m, 45s, or a bare number (= hours).
# Sleep also comes back on when the charge drops to/below 20% while unplugged;
# --battery=N moves that threshold, --no-battery drops to a time-only guardrail.
#
# "on" uses `sudo pmset -a disablesleep 1`, the switch that keeps the machine
# awake even with the lid shut, runs `caffeinate`, and dims the built-in display
# while the lid is closed. A background guardrail (running as root, so it needs
# no second password) flips sleep back on after DURATION — or early on low
# battery. "off" reverses everything immediately. Note: macOS resets
# disablesleep on reboot.
#
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_PATH="$SCRIPT_DIR/$(basename "${BASH_SOURCE[0]}")"
readonly SCRIPT_DIR SCRIPT_PATH
# NOSLEEP_STATE_DIR is how cmd_on hands the resolved path to the root-owned
# guardrail: sudo's env_reset drops XDG_STATE_HOME, so the guardrail can't
# re-derive the same directory on its own.
readonly STATE_DIR="${NOSLEEP_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/nosleep}"
readonly CAFFEINATE_PIDFILE="$STATE_DIR/caffeinate.pid"
readonly LID_WATCHER_PIDFILE="$STATE_DIR/lid-watcher.pid"
readonly DISPLAY_ID_FILE="$STATE_DIR/builtin-display-id"
readonly SAVED_BRIGHTNESS_FILE="$STATE_DIR/saved-brightness"
readonly TIMER_PIDFILE="$STATE_DIR/timer.pid"
readonly OFF_AT_FILE="$STATE_DIR/off_at"
readonly BATTERY_THRESHOLD_FILE="$STATE_DIR/battery_threshold"
readonly BRIGHTNESS_BIN="${NOSLEEP_BRIGHTNESS_BIN:-$SCRIPT_DIR/nosleep-brightness}"
readonly IOREG_BIN="${NOSLEEP_IOREG_BIN:-ioreg}"
readonly PMSET_BIN="${NOSLEEP_PMSET_BIN:-pmset}"
readonly DEFAULT_DURATION="3h"
readonly DEFAULT_BATTERY_THRESHOLD=20
# Bad values would make the guardrail's `sleep` fail and leave sleep disabled
# for good, so fall back rather than trust the override.
POLL_INTERVAL="${NOSLEEP_POLL_INTERVAL:-30}"
[[ "$POLL_INTERVAL" =~ ^[1-9][0-9]*$ ]] || POLL_INTERVAL=30
readonly POLL_INTERVAL

log() { printf '%s\n' "$*"; }
warn() { printf 'nosleep: %s\n' "$*" >&2; }
die() { warn "$*"; exit 1; }

usage() {
  cat <<USAGE
Usage: nosleep <on [DURATION] [--battery=N|--no-battery] | off | status>

  on [DURATION]   Disable sleep (survives lid close), auto-off after DURATION.
                  DURATION defaults to $DEFAULT_DURATION. Accepts 3h, 90m, 45s, or bare hours.
                  Also auto-offs at $DEFAULT_BATTERY_THRESHOLD% charge while on battery power.
     --battery=N    Move that threshold (N is 1-99)
     --no-battery   Turn it off — auto-off on DURATION alone
  off             Restore normal sleep behavior now
  status          Show current state and time remaining

  -h, --help      Show this help
USAGE
}

# macOS-only (pmset and caffeinate ship with it). Also make sure the state
# directory exists before any command touches it.
preflight() {
  [[ "$(uname -s)" == "Darwin" ]] || die "only works on macOS (needs pmset and caffeinate)."
  local cmd
  for cmd in pmset caffeinate; do
    command -v "$cmd" >/dev/null 2>&1 || die "required command not found: $cmd"
  done
  mkdir -p "$STATE_DIR"
}

# cmd_on/cmd_off interpolate these paths single-quoted into a root shell string,
# where a literal quote would break out of the quoting. `status` never builds
# that string, so it stays usable either way.
assert_quote_free_paths() {
  [[ "$SCRIPT_PATH$STATE_DIR$PMSET_BIN" != *"'"* ]] \
    || die "install path, state dir, and pmset path must not contain a single quote."
}

preflight_lid_brightness() {
  command -v "$IOREG_BIN" >/dev/null 2>&1 || die "required command not found: $IOREG_BIN"
  [[ -x "$BRIGHTNESS_BIN" ]] || die "brightness helper not found: $BRIGHTNESS_BIN (run 'make install')."
  "$BRIGHTNESS_BIN" --help >/dev/null 2>&1 || die "brightness helper is not usable."
}

# Parse a duration into seconds. Accepts Nh, Nm, Ns, or bare N (hours).
parse_duration() {
  local d="$1" n unit
  [[ "$d" =~ ^([0-9]+)([hHmMsS]?)$ ]] || return 1
  n="${BASH_REMATCH[1]}"
  unit="${BASH_REMATCH[2]:-h}"
  [[ "$n" -gt 0 ]] || return 1
  case "$unit" in
    h|H) echo $((n * 3600)) ;;
    m|M) echo $((n * 60)) ;;
    s|S) echo "$n" ;;
  esac
}

# True if the given PID is live and actually a caffeinate process (guards
# against a recycled PID pointing at something unrelated).
is_our_caffeinate() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ "$(ps -p "$pid" -o comm= 2>/dev/null)" == *caffeinate ]]
}

# True if the given PID is live and actually our root-owned auto-off guardrail.
# The pidfile lives in a user-writable dir, so validate before ever handing a
# value to the root shell: reject non-numeric junk, then confirm the process
# command line is the guardrail we armed (guards against a recycled/stale PID).
# No `kill -0` here: the guardrail is root-owned, so signalling it from the user
# would fail with EPERM even while it's alive. `ps` sees it regardless of
# ownership, so the command-line match confirms both existence and identity.
is_our_timer() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  [[ "$(ps -p "$pid" -o command= 2>/dev/null)" == *"_guardrail"* ]]
}

# Emit the root-shell snippet that cancels a pending auto-off timer, run inside
# the sudo bash -c strings in cmd_on/cmd_off. The PID is read and validated
# here (user-side) so only a known-good numeric PID can reach `kill` as root;
# anything else drops the pidfile without killing. A small check-then-kill race
# remains (same class as the caffeinate path) — acceptable.
cancel_timer_snippet() {
  local pid
  pid="$(cat "$TIMER_PIDFILE" 2>/dev/null || true)"
  if is_our_timer "$pid"; then
    printf "kill %s 2>/dev/null || true; rm -f '%s'" "$pid" "$TIMER_PIDFILE"
  else
    printf "rm -f '%s'" "$TIMER_PIDFILE"
  fi
}

start_caffeinate() {
  local secs="$1"
  # -d display, -i idle system, -m disk, -s system (AC), -u assert user active
  # -t bounds it to the same window; nohup so it outlives this shell / terminal.
  nohup caffeinate -dimsu -t "$secs" >/dev/null 2>&1 </dev/null &
  echo $! > "$CAFFEINATE_PIDFILE"
}

stop_caffeinate() {
  # Read the pidfile once and kill exactly the value we validated — a second
  # read could be rewritten by a concurrent `nosleep on` (TOCTOU).
  local pid
  pid="$(cat "$CAFFEINATE_PIDFILE" 2>/dev/null || true)"
  if is_our_caffeinate "$pid"; then
    kill "$pid" 2>/dev/null || true
  fi
  rm -f "$CAFFEINATE_PIDFILE"
}

caffeinate_running() {
  is_our_caffeinate "$(cat "$CAFFEINATE_PIDFILE" 2>/dev/null || true)"
}

external_caffeinate_running() {
  ps -axo comm= 2>/dev/null \
    | awk '$0 ~ /(^|\/)caffeinate$/ { found=1 } END { exit !found }'
}

is_our_lid_watcher() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  [[ "$(ps -p "$pid" -o command= 2>/dev/null)" == *"_watch-lid"* ]]
}

lid_watcher_running() {
  is_our_lid_watcher "$(cat "$LID_WATCHER_PIDFILE" 2>/dev/null || true)"
}

external_lid_watcher_running() {
  ps -axo comm=,command= 2>/dev/null \
    | awk '$1 ~ /(^|\/)bash$/ && index($0, "plugin.sh _lid-monitor") { found=1 } END { exit !found }'
}

herdr_plugin_monitor_running() {
  ps -axo comm=,command= 2>/dev/null \
    | awk '$1 ~ /(^|\/)bash$/ && index($0, "plugin.sh _monitor") { found=1 } END { exit !found }'
}

herdr_plugin_active() {
  herdr_plugin_monitor_running \
    && external_caffeinate_running \
    && external_lid_watcher_running
}

start_lid_watcher() {
  local secs="$1"
  nohup bash "$SCRIPT_PATH" _watch-lid "$secs" >/dev/null 2>&1 </dev/null &
  echo $! > "$LID_WATCHER_PIDFILE"
}

stop_lid_watcher() {
  local mode="${1:-restore}" pid i
  pid="$(cat "$LID_WATCHER_PIDFILE" 2>/dev/null || true)"
  if is_our_lid_watcher "$pid"; then
    if [[ "$mode" == "preserve" ]]; then
      kill -USR1 "$pid" 2>/dev/null || true
    else
      kill "$pid" 2>/dev/null || true
    fi
    for ((i = 0; i < 30; i++)); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.1
    done
  fi
  rm -f "$LID_WATCHER_PIDFILE"
}

read_lid_state() {
  local value
  value="$("$IOREG_BIN" -r -k AppleClamshellState -d 4 2>/dev/null \
    | awk '/"AppleClamshellState"/ {print $NF; exit}')"
  case "$value" in
    Yes) printf 'closed\n' ;;
    No)  printf 'open\n' ;;
    *)   return 1 ;;
  esac
}

# Print "PCT SOURCE" (e.g. "63 battery", "63 ac") from a single `pmset -g batt`
# read — no root needed. Fails if the charge can't be parsed, which is also how
# a Mac with no battery reads. Shared by the poll loop and `status` so the
# parse lives in exactly one place.
battery_read() {
  local out
  out="$("$PMSET_BIN" -g batt 2>/dev/null)" || return 1
  [[ "$out" =~ ([0-9]+)% ]] || return 1
  if [[ "$out" == *"'Battery Power'"* ]]; then
    printf '%s battery\n' "${BASH_REMATCH[1]}"
  else
    printf '%s ac\n' "${BASH_REMATCH[1]}"
  fi
}

# True iff running on battery power AND charge <= threshold. On AC power, or
# when the reading can't be parsed, returns false — a bad read must never force
# sleep back on.
battery_should_trigger() {
  local threshold="$1" reading
  [[ "$threshold" =~ ^[0-9]+$ ]] && [[ "$threshold" -gt 0 ]] || return 1
  reading="$(battery_read)" || return 1
  [[ "$reading" == *" battery" ]] || return 1
  [[ "${reading%% *}" -le "$threshold" ]]
}

# Print "NN%, on battery" / "NN%, on AC" for `status`. Fails if unparseable.
battery_status_line() {
  local reading
  reading="$(battery_read)" || return 1
  if [[ "$reading" == *" battery" ]]; then
    printf '%s%%, on battery' "${reading%% *}"
  else
    printf '%s%%, on AC' "${reading%% *}"
  fi
}

restore_saved_brightness() {
  local display_id saved
  [[ -f "$SAVED_BRIGHTNESS_FILE" ]] || return 0
  display_id="$(cat "$DISPLAY_ID_FILE" 2>/dev/null || true)"
  saved="$(cat "$SAVED_BRIGHTNESS_FILE" 2>/dev/null || true)"
  [[ -n "$saved" ]] || return 1
  if { [[ "$display_id" =~ ^[0-9]+$ ]] \
      && "$BRIGHTNESS_BIN" --display "$display_id" set "$saved" >/dev/null 2>&1; } \
      || "$BRIGHTNESS_BIN" set "$saved" >/dev/null 2>&1; then
    rm -f "$DISPLAY_ID_FILE" "$SAVED_BRIGHTNESS_FILE"
    return 0
  fi
  return 1
}

cmd_watch_lid() {
  local secs="$1" deadline state previous_state="" snapshot display_id="" saved="" preserve_state=0 i
  [[ "$secs" =~ ^[0-9]+$ ]] && [[ "$secs" -gt 0 ]] || exit 1
  mkdir -p "$STATE_DIR"
  deadline=$(( $(date +%s) + secs ))
  display_id="$(cat "$DISPLAY_ID_FILE" 2>/dev/null || true)"
  saved="$(cat "$SAVED_BRIGHTNESS_FILE" 2>/dev/null || true)"

  cleanup_lid_watcher() {
    if [[ "$preserve_state" != "1" ]]; then
      for ((i = 0; i < 5; i++)); do
        restore_saved_brightness && break
        sleep 0.1
      done
    fi
    rm -f "$LID_WATCHER_PIDFILE"
  }
  trap 'preserve_state=1; exit 0' USR1
  trap 'exit 0' INT TERM HUP
  trap cleanup_lid_watcher EXIT

  while [[ "$(date +%s)" -lt "$deadline" ]]; do
    if state="$(read_lid_state)"; then
      if [[ "$state" == "open" && "$previous_state" != "open" ]]; then
        restore_saved_brightness || true
        if snapshot="$("$BRIGHTNESS_BIN" snapshot 2>/dev/null)"; then
          display_id="${snapshot%% *}"
          saved="${snapshot#* }"
        fi
      elif [[ "$state" == "closed" && "$previous_state" != "closed" ]]; then
        if [[ "$display_id" =~ ^[0-9]+$ && -n "$saved" ]]; then
          if [[ "$previous_state" == "open" ]]; then
            saved="$("$BRIGHTNESS_BIN" --display "$display_id" get 2>/dev/null || printf '%s' "$saved")"
          fi
          printf '%s\n' "$display_id" > "$DISPLAY_ID_FILE"
          printf '%s\n' "$saved" > "$SAVED_BRIGHTNESS_FILE"
          if ! "$BRIGHTNESS_BIN" --display "$display_id" set 0 >/dev/null 2>&1; then
            rm -f "$DISPLAY_ID_FILE" "$SAVED_BRIGHTNESS_FILE"
          fi
        fi
      fi
      previous_state="$state"
    fi
    sleep 1
  done
  trap - EXIT
  cleanup_lid_watcher
}

# Root-owned auto-off guardrail (started detached by cmd_on). Waits out DURATION,
# or exits early if the battery drops to/below THRESHOLD while unplugged
# (THRESHOLD 0 = time-only, the historical behavior). On exit it re-enables sleep
# and clears the run's state. Runs as root in production so it can flip
# disablesleep back on without a second password.
cmd_guardrail() {
  local secs="$1" threshold="${2:-0}" deadline remaining early=0 i
  [[ "$secs" =~ ^[0-9]+$ ]] && [[ "$secs" -gt 0 ]] || exit 1
  if [[ "$threshold" =~ ^[0-9]{1,3}$ ]]; then
    threshold=$((10#$threshold))
  else
    threshold=0
  fi

  if [[ "$threshold" -gt 0 ]]; then
    deadline=$(( $(date +%s) + secs ))
    while :; do
      remaining=$(( deadline - $(date +%s) ))
      [[ "$remaining" -gt 0 ]] || break
      if battery_should_trigger "$threshold"; then
        early=1
        break
      fi
      # Never sleep past the deadline, or the timed auto-off would land up to a
      # full poll interval after the time `status` advertised.
      if [[ "$remaining" -lt "$POLL_INTERVAL" ]]; then sleep "$remaining"; else sleep "$POLL_INTERVAL"; fi
    done
  else
    sleep "$secs"
  fi

  # An early (battery) exit fires before caffeinate and the lid watcher hit
  # their own deadlines, so stop them now; killing the lid watcher triggers its
  # brightness-restore trap, and stop_lid_watcher waits out the process. On a
  # normal deadline exit both self-expire, so we only wait for the lid watcher
  # to clear its pidfile — the signal that its trap has finished restoring.
  if [[ "$early" == "1" ]]; then
    stop_caffeinate
    stop_lid_watcher
  else
    for ((i = 0; i < 30; i++)); do
      [[ -f "$LID_WATCHER_PIDFILE" ]] || break
      sleep 0.1
    done
  fi

  "$PMSET_BIN" -a disablesleep 0
  rm -f "$TIMER_PIDFILE" "$OFF_AT_FILE" "$LID_WATCHER_PIDFILE" "$BATTERY_THRESHOLD_FILE"
}

cmd_on() {
  # The guardrail is armed by default — leaving an unplugged Mac to drain flat is
  # the worse failure. Armed-ness is tracked apart from the value so that no
  # threshold the user can type — '0', '' — doubles as "unarmed" and disarms it
  # silently; `explicit` separates "asked for it" from the default, so we only
  # complain about a machine with no battery when it was actually requested.
  # A value only ever comes from `--battery=N`: DURATION accepts a bare number of
  # hours, so a separate `--battery N` token would be ambiguous.
  local dur="" threshold="$DEFAULT_BATTERY_THRESHOLD" battery=1 explicit=0 secs off_at_human arg
  assert_quote_free_paths
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      --battery)    battery=1; explicit=1; threshold="$DEFAULT_BATTERY_THRESHOLD" ;;
      --battery=*)  battery=1; explicit=1; threshold="${arg#--battery=}" ;;
      --no-battery) battery=0 ;;
      -*)           die "unknown option: '$arg'" ;;
      *)
        [[ -z "$dur" ]] || die "unexpected argument: '$arg'"
        dur="$arg"
        ;;
    esac
    shift
  done
  dur="${dur:-$DEFAULT_DURATION}"

  if ! secs="$(parse_duration "$dur")"; then
    die "invalid duration: '$dur' (use 3h, 90m, 45s, or a bare number of hours)"
  fi
  # Validate whatever was typed even if a later --no-battery disarms it, so a
  # bad threshold is never silently accepted.
  if [[ "$explicit" == "1" ]]; then
    # Normalize to base 10 before comparing: bash reads a leading zero as octal,
    # which would reject '08' outright and quietly turn '010' into 8.
    { [[ "$threshold" =~ ^[0-9]{1,3}$ ]] \
      && [[ "$((10#$threshold))" -ge 1 ]] && [[ "$((10#$threshold))" -le 99 ]]; } \
      || die "invalid battery threshold: '$threshold' (use 1-99)"
    threshold="$((10#$threshold))"
  fi
  # A Mac with no battery can never trip the guardrail, so don't report it as
  # armed. Silent unless it was asked for by name — desktops would see it every run.
  if [[ "$battery" == "1" ]] && ! battery_read >/dev/null; then
    battery=0
    [[ "$explicit" == "0" ]] \
      || warn "no battery reading available — the low-battery guardrail can never fire."
  fi
  preflight_lid_brightness
  off_at_human="$(date -v"+${secs}S" '+%I:%M %p')"

  log "Disabling sleep for $dur."
  # One sudo call: cancel any prior guardrail, disable sleep, arm a root-owned
  # guardrail that re-enables sleep after DURATION (or early on low battery)
  # without needing a second password. sudo's env_reset would otherwise strip
  # our overrides, leaving the guardrail pointed at a different state dir.
  sudo bash -c "
    $(cancel_timer_snippet)
    pmset -a disablesleep 1
    nohup env NOSLEEP_STATE_DIR='$STATE_DIR' NOSLEEP_PMSET_BIN='$PMSET_BIN' \
      NOSLEEP_POLL_INTERVAL='$POLL_INTERVAL' \
      bash '$SCRIPT_PATH' _guardrail $secs $(( battery == 1 ? threshold : 0 )) >/dev/null 2>&1 </dev/null &
    echo \$! > '$TIMER_PIDFILE'
  "

  stop_lid_watcher preserve
  stop_caffeinate
  start_caffeinate "$secs"
  start_lid_watcher "$secs"
  echo "$(( $(date +%s) + secs ))" > "$OFF_AT_FILE"
  if [[ "$battery" == "1" ]]; then
    echo "$threshold" > "$BATTERY_THRESHOLD_FILE"
    log "Sleep disabled. Auto-off at $off_at_human or when battery <= ${threshold}% (or run 'nosleep off')."
  else
    rm -f "$BATTERY_THRESHOLD_FILE"
    log "Sleep disabled. Auto-off at $off_at_human (or run 'nosleep off')."
  fi
}

cmd_off() {
  assert_quote_free_paths
  log "Restoring normal sleep behavior."
  sudo -v
  stop_lid_watcher
  restore_saved_brightness || true
  sudo bash -c "
    $(cancel_timer_snippet)
    pmset -a disablesleep 0
  "
  stop_caffeinate
  rm -f "$OFF_AT_FILE" "$BATTERY_THRESHOLD_FILE"
  log "Sleep restored to normal."
}

cmd_status() {
  local ds herdr_active=0 herdr_monitor=0
  # pmset reports this as "SleepDisabled" in `pmset -g`, even though it's set
  # via `pmset -a disablesleep`. Match either name, case-insensitively.
  ds="$("$PMSET_BIN" -g | awk 'tolower($0) ~ /sleepdisabled|disablesleep/ {print $2; exit}')"
  ds="${ds:-0}"
  herdr_plugin_monitor_running && herdr_monitor=1
  herdr_plugin_active && herdr_active=1

  if [[ "$ds" == "1" ]]; then
    if [[ "$herdr_active" == "1" ]]; then
      log "disablesleep : ON  (managed by Herdr plugin; lid-close sleep disabled)"
    else
      log "disablesleep : ON  (Mac will not sleep, even with the lid closed)"
    fi
  else
    # Any leftover timer/off_at state is stale — e.g. after a reboot, which
    # resets disablesleep but leaves these files behind. Clean it up so we
    # never report a phantom auto-off below.
    stop_lid_watcher
    restore_saved_brightness || true
    rm -f "$OFF_AT_FILE" "$TIMER_PIDFILE" "$BATTERY_THRESHOLD_FILE"
    log "disablesleep : off (normal sleep behavior)"
  fi

  if caffeinate_running; then
    log "caffeinate   : running"
  elif [[ "$herdr_active" == "1" ]]; then
    log "caffeinate   : running (Herdr plugin)"
  elif external_caffeinate_running; then
    log "caffeinate   : running (externally managed)"
  else
    log "caffeinate   : not running"
  fi

  if lid_watcher_running; then
    log "lid watcher  : running"
  elif [[ "$herdr_active" == "1" ]]; then
    log "lid watcher  : running (Herdr plugin)"
  elif external_lid_watcher_running; then
    log "lid watcher  : running (externally managed)"
  else
    log "lid watcher  : not running"
  fi

  if [[ "$herdr_active" == "1" ]]; then
    log "Herdr plugin : active (working agent detected)"
  elif [[ "$herdr_monitor" == "1" ]]; then
    log "Herdr plugin : monitoring (no working agents)"
  fi

  if [[ "$ds" == "1" && -f "$OFF_AT_FILE" ]]; then
    local off_at now rem
    off_at="$(cat "$OFF_AT_FILE")"
    now="$(date +%s)"
    rem=$((off_at - now))
    if [[ "$rem" -gt 0 ]]; then
      printf 'auto-off in  : %dh %02dm (at %s)\n' \
        $((rem / 3600)) $(((rem % 3600) / 60)) "$(date -r "$off_at" '+%I:%M %p')"
    fi
  fi

  if [[ "$ds" == "1" && -f "$BATTERY_THRESHOLD_FILE" ]]; then
    local thr now_line
    thr="$(cat "$BATTERY_THRESHOLD_FILE" 2>/dev/null || true)"
    if [[ "$thr" =~ ^[0-9]+$ ]]; then
      if now_line="$(battery_status_line)"; then
        log "battery      : auto-off <= ${thr}% (currently ${now_line})"
      else
        log "battery      : auto-off <= ${thr}%"
      fi
    fi
  fi
}

case "${1:-}" in
  on)                   preflight; cmd_on "${@:2}" ;;
  off)                  preflight; cmd_off ;;
  status)               preflight; cmd_status ;;
  _watch-lid)           cmd_watch_lid "${2:-}" ;;
  _guardrail)           cmd_guardrail "${2:-}" "${3:-}" ;;
  -h|--help|help)       usage ;;
  *)                    usage >&2; exit 1 ;;
esac
